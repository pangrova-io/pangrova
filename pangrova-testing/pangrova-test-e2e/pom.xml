<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.pangrova</groupId>
        <artifactId>pangrova-testing</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>pangrova-test-e2e</artifactId>
    <name>Pangrova Test E2E</name>
    <description>End-to-end and chaos testing frameworks</description>

    <dependencies>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-client-cli</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-connector-lance</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-test-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-observability</artifactId>
        </dependency>
        <!-- Pipeline integration dependencies for E2E tests -->
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-worker</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <classifier>native-fixtures</classifier>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-shuffle-service</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-coordinator</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-worker</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-protocol</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-transport</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-spi</artifactId>
        </dependency>

        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-security</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-metadata</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-planner</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-connector-iceberg</artifactId>
            <scope>test</scope>
            <exclusions>
                <!-- Hadoop brings Jersey 1.x which conflicts with Jersey 3.x (Jakarta EE 9+).
                     com.sun.jersey + javax.ws.rs:jsr311-api poison the Jersey 3.x provider
                     scanner, causing all JAX-RS resources to be silently ignored. -->
                <exclusion>
                    <groupId>com.sun.jersey</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.sun.jersey.contribs</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.github.pjfanning</groupId>
                    <artifactId>jersey-json</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>javax.ws.rs</groupId>
                    <artifactId>jsr311-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-connector-paimon</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.paimon</groupId>
            <artifactId>paimon-lance</artifactId>
            <version>${paimon.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-indexing</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-governance</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-resilience</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-streaming</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-server</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-servlet</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <!-- F-E2E-01..05: replace Thread.sleep polling with Awaitility. -->
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-client-jdbc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-client-rest</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>native-runtime</id>
            <dependencies>
                <!-- Isolated E2E runs do not build the Worker project, so its
                     project profile cannot supply this transitive dependency. -->
                <dependency>
                    <groupId>org.pangrova</groupId>
                    <artifactId>pangrova-native-bundle</artifactId>
                    <classifier>${os.detected.classifier}</classifier>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <testResource>
                <directory>${project.basedir}/../../pangrova-protocol/src/test/resources</directory>
                <includes>
                    <include>function-contracts/actual-native-catalogue.bin</include>
                </includes>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Force fork JVM to match the Maven process JDK (prevents x86_64/arm64 mismatch) -->
                    <jvm>${java.home}/bin/java</jvm>
                    <!-- Exclude routing harness, native-only bootstrap, and performance benchmarks -->
                    <excludedGroups>${pangrova.e2e.excludedGroups}</excludedGroups>
                    <argLine>
                        @{jacoco.agent.argLine}
                        -Xmx2g -Xms512m
                        <!-- MEM-R2: 2g direct-memory cap. The previous 8g cap let heap(2g)+direct(8g)
                             exceed half the physical RAM of a 16GB dev machine; combined with the
                             Docker VM (~8GiB) it triggered system-wide memory exhaustion and
                             Docker VM OOM-kill during E2E runs. Arrow result fetching is already
                             bounded by a 512MB allocator; 2g leaves 4x headroom. -->
                        -XX:MaxDirectMemorySize=2g
                        -Dio.netty.maxDirectMemory=0
                        --patch-module java.base=${project.basedir}/src/test/resources/patch-java-base
                        --add-opens=java.base/java.nio=ALL-UNNAMED
                        --add-opens=java.base/javax.security.auth=ALL-UNNAMED
                        --add-opens=java.base/java.lang=ALL-UNNAMED
                        --add-opens=java.base/java.lang.reflect=ALL-UNNAMED
                        --add-opens=java.base/java.util=ALL-UNNAMED
                        --add-opens=java.base/java.util.concurrent=ALL-UNNAMED
                        --add-opens=java.base/sun.security.action=ALL-UNNAMED
                        --add-opens=java.base/sun.nio.ch=ALL-UNNAMED
                        -XX:ErrorFile=${maven.multiModuleProjectDirectory}/pangrova-testing/pangrova-test-e2e/target/hs_err_pid%p.log
                    </argLine>
                    <systemPropertyVariables>
                        <HADOOP_USER_NAME>pangrova</HADOOP_USER_NAME>
                    </systemPropertyVariables>
                    <reuseForks>true</reuseForks>
                    <forkCount>1</forkCount>
                    <!-- Docker Engine 29.x requires API >= 1.44; docker-java defaults to 1.32 -->
                    <environmentVariables>
                        <DOCKER_API_VERSION>1.44</DOCKER_API_VERSION>
                        <TESTCONTAINERS_RYUK_DISABLED>false</TESTCONTAINERS_RYUK_DISABLED>
                        <HADOOP_USER_NAME>pangrova</HADOOP_USER_NAME>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
