# ============================================================
# Pangrova Coordinator — JVM Configuration (Production)
#
# JVM options for the Coordinator process, one option per line.
# Lines starting with # are comments; blank lines are ignored.
#
# Loaded by: bin/pangrova-coordinator.sh (and pangrova-standalone.sh
#            when ROLE=coordinator)
#
# Precedence (highest → lowest):
#   PANGROVA_JAVA_OPTS env  →  this file  →  script defaults
#
# Sizing guide (total node RAM):
#   32 GB  →  -Xmx12g   MaxDirectMemorySize=2g
#   64 GB  →  -Xmx24g   MaxDirectMemorySize=4g
#  128 GB  →  -Xmx48g   MaxDirectMemorySize=8g
# ============================================================


# ── Heap ────────────────────────────────────────────────────
# Set Xms == Xmx to avoid heap resizing pauses on startup.
# The Coordinator is metadata-heavy; 16 GB covers query result
# caches and large catalogs. Increase to 32 GB on busy clusters.
-Xms16g
-Xmx16g


# ── Thread stack ─────────────────────────────────────────────
# 512 KB is sufficient for Calcite planning recursion depth.
# Deep SQL parse trees may require 1m; increase if you see
# StackOverflowError in the planner.
-Xss512k


# ── Garbage Collector — G1GC ─────────────────────────────────
-XX:+UseG1GC

# Region size — 32 MB fits most allocation patterns for the
# Coordinator's mixed small-object and medium-object workload.
-XX:G1HeapRegionSize=32m

# Pause target — 200 ms is a reasonable balance for an OLAP
# query coordinator. Lower to 100 ms if you observe noticeable
# latency spikes under light load.
-XX:MaxGCPauseMillis=200

# Trigger concurrent GC when 45% of heap is occupied.
# Lower than the G1GC default (45%) avoids late concurrent cycles.
-XX:InitiatingHeapOccupancyPercent=45
-XX:+G1UseAdaptiveIHOP

# Young generation sizing — keep young gen at 20–40% of heap.
-XX:G1NewSizePercent=20
-XX:G1MaxNewSizePercent=40

# Limit mixed GC collection rounds to spread reclamation work.
-XX:G1MixedGCCountTarget=8

# Process reference queues in parallel during GC.
-XX:+ParallelRefProcEnabled

# Deduplicate String instances with identical content — beneficial
# for schema names and SQL text that appear in many query contexts.
-XX:+G1EnableStringDeduplication


# ── GC Logging ──────────────────────────────────────────────
# Unified GC log (JEP 158, Java 9+). Rotate at 64 MB, keep 5
# files. Adjust log path via PANGROVA_LOG_DIR env if needed.
-Xlog:gc*,safepoint:file=${PANGROVA_LOG_DIR:-logs}/gc-coordinator.log:time,uptime,level,tags:filecount=5,filesize=64m


# ── OOM Handling ─────────────────────────────────────────────
# Exit immediately on OutOfMemoryError — a zombie Coordinator
# that cannot allocate causes split-brain. The process manager
# (systemd / Kubernetes) will restart it.
-XX:+ExitOnOutOfMemoryError

# Capture heap dump for post-mortem analysis.
-XX:+HeapDumpOnOutOfMemoryError
-XX:HeapDumpPath=${PANGROVA_LOG_DIR:-logs}/heapdump-coordinator.hprof


# ── Native Memory Tracking ───────────────────────────────────
# Enables jcmd <pid> VM.native_memory to diagnose native memory
# leaks. "summary" has negligible overhead; switch to "detail"
# only when diagnosing a specific leak.
-XX:NativeMemoryTracking=summary


# ── JMX — Local Monitoring ───────────────────────────────────
# Exposes MBeans for JConsole / VisualVM / Prometheus JMX scraper.
# Bind only to 127.0.0.1 for security; expose over SSH tunnel
# or reverse proxy if remote access is needed.
-Dcom.sun.management.jmxremote=true
-Dcom.sun.management.jmxremote.port=9900
-Dcom.sun.management.jmxremote.rmi.port=9900
-Dcom.sun.management.jmxremote.local.only=true
-Dcom.sun.management.jmxremote.ssl=false
-Dcom.sun.management.jmxremote.authenticate=false
-Djava.rmi.server.hostname=127.0.0.1


# ── Profiler / Async-Profiler ─────────────────────────────────
# Required for CPU flame graphs with async-profiler's frame
# pointer walking mode (-e cpu). No runtime overhead.
-XX:+PreserveFramePointer


# ── Module / Reflection Unlocking ────────────────────────────
# Required by Netty (NIO channel internals), Apache Arrow
# (unsafe off-heap access), Calcite reflection, and Kryo.
# These will become unnecessary when libraries provide JPMS
# module declarations; until then they are mandatory.
--add-opens=java.base/sun.nio.ch=ALL-UNNAMED
--add-opens=java.base/java.lang=ALL-UNNAMED
--add-opens=java.base/java.lang.reflect=ALL-UNNAMED
--add-opens=java.base/java.io=ALL-UNNAMED
--add-opens=java.base/java.util=ALL-UNNAMED
--add-opens=java.base/java.util.concurrent=ALL-UNNAMED
--add-opens=java.base/java.nio=ALL-UNNAMED


# ── Locale / Encoding ────────────────────────────────────────
# Force UTF-8 everywhere for consistent SQL string handling.
-Dfile.encoding=UTF-8
-Dstdout.encoding=UTF-8
-Dstderr.encoding=UTF-8

# Force UTC for all timestamp formatting. Store and compare
# timestamps in UTC; convert to user-local time in the client.
-Duser.timezone=UTC


# ── Networking ───────────────────────────────────────────────
# Prefer IPv4 to avoid dual-stack resolution issues in
# environments where IPv6 is not fully configured.
-Djava.net.preferIPv4Stack=true

# Disable DNS negative-entry caching so that re-registered
# worker hostnames resolve immediately after restart.
-Dsun.net.inetaddr.ttl=30
-Dsun.net.inetaddr.negative.ttl=0
