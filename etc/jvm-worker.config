# ============================================================
# Pangrova Worker — JVM Configuration (Production)
#
# JVM options for the Worker process, one option per line.
# Lines starting with # are comments; blank lines are ignored.
#
# Loaded by: bin/pangrova-worker.sh
#
# Precedence (highest → lowest):
#   PANGROVA_JAVA_OPTS env  →  this file  →  script defaults
#
# Memory model:
#   JVM heap (Xmx)          — result sets, task metadata, coordinator I/O
#   Arrow off-heap (MaxDMem) — columnar data buffers (ArrowBuf)
#   Velox native cache       — configured in worker.yml native-cache section
#   OS page cache            — left to OS; see pangrova-env.sh for vm.swappiness
#
# Sizing guide (total node RAM):
#   64  GB  →  -Xmx24g   MaxDirectMemorySize=8g   Velox cache 24 GB
#   128 GB  →  -Xmx32g   MaxDirectMemorySize=16g  Velox cache 64 GB
#   256 GB  →  -Xmx48g   MaxDirectMemorySize=32g  Velox cache 128 GB
# ============================================================


# ── Heap ────────────────────────────────────────────────────
# Workers are execution nodes. Java heap is used for task
# scheduling, result buffering, and shuffle metadata.
# Most data volume lives in Arrow off-heap (MaxDirectMemorySize)
# and the native Velox cache — do NOT set Xmx too high or you
# will starve off-heap and native layers.
-Xms32g
-Xmx32g


# ── Arrow / Off-Heap ─────────────────────────────────────────
# Apache Arrow columnar buffers are allocated off-heap.
# Set at least 2x the largest expected result batch in memory.
# Increase if you see DirectMemory allocation failures in logs.
-XX:MaxDirectMemorySize=16g


# ── Thread stack ─────────────────────────────────────────────
-Xss512k


# ── Garbage Collector — G1GC ─────────────────────────────────
-XX:+UseG1GC

# 32 MB regions suit the Worker's mixed allocation patterns:
# small task objects, medium shuffle buffers, large result records.
-XX:G1HeapRegionSize=32m

# Workers tolerate longer GC pauses than coordinators because
# query execution is already latency-bounded by I/O. 300 ms
# is a good starting point; reduce if tail latency is critical.
-XX:MaxGCPauseMillis=300

# Start concurrent GC at 40% occupancy — earlier than the
# default to avoid sudden mixed-collection bursts during
# heavy scan phases that allocate fast.
-XX:InitiatingHeapOccupancyPercent=40
-XX:+G1UseAdaptiveIHOP

# Keep young generation small relative to total heap so that
# concurrent old-gen reclamation has time to run alongside
# fast-allocating scan pipelines.
-XX:G1NewSizePercent=15
-XX:G1MaxNewSizePercent=35

# Spread mixed collection over more rounds to reduce per-pause
# cost during concurrent GC phases.
-XX:G1MixedGCCountTarget=12

# Parallel reference processing — important for Workers that
# iterate large result sets with many object references.
-XX:+ParallelRefProcEnabled

# String deduplication saves heap when many query fragments
# share the same column name / schema strings.
-XX:+G1EnableStringDeduplication


# ── GC Logging ──────────────────────────────────────────────
-Xlog:gc*,safepoint:file=${PANGROVA_LOG_DIR:-logs}/gc-worker.log:time,uptime,level,tags:filecount=5,filesize=64m


# ── OOM Handling ─────────────────────────────────────────────
-XX:+ExitOnOutOfMemoryError
-XX:+HeapDumpOnOutOfMemoryError
-XX:HeapDumpPath=${PANGROVA_LOG_DIR:-logs}/heapdump-worker.hprof


# ── Native Memory Tracking ───────────────────────────────────
# Helps diagnose Arrow/Velox native memory growth. Use
# "jcmd <pid> VM.native_memory summary" to inspect at runtime.
-XX:NativeMemoryTracking=summary


# ── JMX — Local Monitoring ───────────────────────────────────
# Workers use a different port from Coordinators.
-Dcom.sun.management.jmxremote=true
-Dcom.sun.management.jmxremote.port=9901
-Dcom.sun.management.jmxremote.rmi.port=9901
-Dcom.sun.management.jmxremote.local.only=true
-Dcom.sun.management.jmxremote.ssl=false
-Dcom.sun.management.jmxremote.authenticate=false
-Djava.rmi.server.hostname=127.0.0.1


# ── Profiler / Async-Profiler ─────────────────────────────────
-XX:+PreserveFramePointer


# ── Module / Reflection Unlocking ────────────────────────────
# Same requirements as the Coordinator: Netty, Arrow, JNI.
--add-opens=java.base/sun.nio.ch=ALL-UNNAMED
--add-opens=java.base/java.lang=ALL-UNNAMED
--add-opens=java.base/java.lang.reflect=ALL-UNNAMED
--add-opens=java.base/java.io=ALL-UNNAMED
--add-opens=java.base/java.util=ALL-UNNAMED
--add-opens=java.base/java.util.concurrent=ALL-UNNAMED
--add-opens=java.base/java.nio=ALL-UNNAMED


# ── Locale / Encoding ────────────────────────────────────────
-Dfile.encoding=UTF-8
-Dstdout.encoding=UTF-8
-Dstderr.encoding=UTF-8
-Duser.timezone=UTC


# ── Networking ───────────────────────────────────────────────
-Djava.net.preferIPv4Stack=true
-Dsun.net.inetaddr.ttl=30
-Dsun.net.inetaddr.negative.ttl=0
