<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.pangrova</groupId>
        <artifactId>pangrova-shuffle</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>pangrova-shuffle-celeborn</artifactId>
    <name>Pangrova Shuffle Celeborn</name>
    <description>Apache Celeborn (RSS) adapter for the Pangrova shuffle SPI (ADR-002 D4).
        Implements ShuffleLifecycleManager, ExchangeChannelManager, and ShuffleByteEgress
        using Celeborn's push-based shuffle with DURABLE semantics.</description>

    <properties>
        <!-- Celeborn client version — matches Docker image apache/celeborn:0.6.3 -->
        <celeborn.version>0.6.3</celeborn.version>
    </properties>

    <dependencies>
        <!-- Core shuffle SPI interfaces -->
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-shuffle-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-spi</artifactId>
        </dependency>

        <!-- Apache Celeborn client (shaded — includes Netty/Protobuf relocated to avoid conflicts).
             Uses the Spark-3 shaded client as the standalone celeborn-client module is not published
             individually to Maven Central. Only core Celeborn classes (org.apache.celeborn.*) are
             used; Spark-specific plugin classes are never instantiated. -->
        <dependency>
            <groupId>org.apache.celeborn</groupId>
            <artifactId>celeborn-client-spark-3-shaded_2.12</artifactId>
            <version>${celeborn.version}</version>
            <exclusions>
                <!-- Exclude Spark transitive deps — we only use core Celeborn client APIs -->
                <exclusion>
                    <groupId>org.apache.spark</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.scala-lang</groupId>
                    <artifactId>scala-library</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Scala runtime — required by Celeborn common/client internals -->
        <dependency>
            <groupId>org.scala-lang</groupId>
            <artifactId>scala-library</artifactId>
            <version>2.12.18</version>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
