# The selected registration headers and archive must come from one reviewed build.
function(pangrova_verify_function_provenance source_dir include_dir archive)
  set(_patch_script "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../bin/apply-velox-patches.sh")
  set(_patch_file "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../patches/velox-function-metadata-snapshot.patch")
  execute_process(COMMAND bash "${_patch_script}" verify "${source_dir}"
    RESULT_VARIABLE _source_status ERROR_VARIABLE _source_error)
  if(NOT _source_status EQUAL 0)
    message(FATAL_ERROR "Registration source provenance failed: ${_source_error}")
  endif()
  file(STRINGS "${_patch_file}" _patched_headers REGEX "^\\+\\+\\+ b/.*\\.h$")
  if(NOT _patched_headers)
    message(FATAL_ERROR "Registration patch does not declare its selected SDK headers")
  endif()
  foreach(_header IN LISTS _patched_headers)
    string(REGEX REPLACE "^\\+\\+\\+ b/" "" _header "${_header}")
    if(NOT EXISTS "${source_dir}/${_header}" OR NOT EXISTS "${include_dir}/${_header}")
      message(FATAL_ERROR "Selected SDK registration header is missing: ${_header}")
    endif()
    file(SHA256 "${source_dir}/${_header}" _source_header)
    file(SHA256 "${include_dir}/${_header}" _selected_header)
    if(NOT _source_header STREQUAL _selected_header)
      message(FATAL_ERROR "Selected registration header differs from rebuilt source: ${_header}")
    endif()
  endforeach()
  if(NOT EXISTS "${archive}.pangrova-provenance")
    message(FATAL_ERROR "Registration archive lacks rebuilt-source provenance: ${archive}")
  endif()
  file(STRINGS "${archive}.pangrova-provenance" _proof)
  file(READ "${archive}.pangrova-provenance" _proof_bytes)
  list(LENGTH _proof _proof_length)
  if(NOT _proof_length EQUAL 5)
    message(FATAL_ERROR "Malformed registration archive provenance: ${archive}")
  endif()
  file(SHA256 "${_patch_file}" _patch_hash)
  file(SHA256 "${archive}" _archive_hash)
  find_package(Python3 3.10 REQUIRED COMPONENTS Interpreter)
  set(_tools "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../pangrova-protocol/tools/function-contracts")
  set(_declaration "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../pangrova-protocol/src/main/resources/function-contracts/execution-selection.json")
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${_tools}/generate_execution_selection.py"
      --declaration "${_declaration}" --input-digest-only
    RESULT_VARIABLE _inputs_status OUTPUT_VARIABLE _inputs_hash
    ERROR_VARIABLE _inputs_error OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT _inputs_status EQUAL 0)
    message(FATAL_ERROR "Cannot verify registration generation inputs: ${_inputs_error}")
  endif()
  list(GET _proof 0 _version)
  list(GET _proof 1 _commit)
  list(GET _proof 2 _recorded_patch)
  list(GET _proof 3 _recorded_inputs)
  list(GET _proof 4 _recorded_archive)
  set(_expected_proof "${_version}\n${_commit}\n${_recorded_patch}\n${_recorded_inputs}\n${_recorded_archive}\n")
  if(NOT _version STREQUAL "pangrova-function-provenance-v2"
      OR NOT _commit STREQUAL "3da0390118fa4b0addbfbdeb03f438ec1b1237a6"
      OR NOT _recorded_patch STREQUAL _patch_hash
      OR NOT _recorded_inputs STREQUAL _inputs_hash
      OR NOT _recorded_archive STREQUAL _archive_hash
      OR NOT _proof_bytes STREQUAL _expected_proof)
    message(FATAL_ERROR "Registration source/patch/generation/archive provenance differs; rebuild ${archive}")
  endif()
endfunction()
