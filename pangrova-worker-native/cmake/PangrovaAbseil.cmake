# SDK consumers must use the selected package targets, not glob a second set
# of Release archives into a sanitizer link.
file(STRINGS "${VELOX_BUILD_DIR}/CMakeCache.txt" _VELOX_ABSL_PACKAGE
  REGEX "^absl_DIR:(PATH|UNINITIALIZED)=")
if(NOT _VELOX_ABSL_PACKAGE)
  message(FATAL_ERROR "Velox does not record its selected Abseil package; rebuild Velox")
endif()
list(GET _VELOX_ABSL_PACKAGE 0 _VELOX_ABSL_PACKAGE)
string(REGEX REPLACE "^absl_DIR:(PATH|UNINITIALIZED)=" "" _VELOX_ABSL_PACKAGE "${_VELOX_ABSL_PACKAGE}")
find_package(absl CONFIG REQUIRED)
file(REAL_PATH "${_VELOX_ABSL_PACKAGE}" _VELOX_ABSL_REAL)
file(REAL_PATH "${absl_DIR}" _PANGROVA_ABSL_REAL)
if(NOT _VELOX_ABSL_REAL STREQUAL _PANGROVA_ABSL_REAL)
  message(FATAL_ERROR "Velox Abseil package differs from Pangrova; select the same package and rebuild")
endif()

function(pangrova_select_abseil_targets output)
  set(_libraries)
  foreach(_library IN LISTS ARGN)
    get_filename_component(_filename "${_library}" NAME)
    if(_filename MATCHES "^libabsl_(.+)\\.a$")
      set(_target "absl::${CMAKE_MATCH_1}")
      if(NOT TARGET "${_target}")
        message(FATAL_ERROR "Selected Abseil package has no target for ${_filename}")
      endif()
      list(APPEND _libraries "${_target}")
    else()
      list(APPEND _libraries "${_library}")
    endif()
  endforeach()
  set("${output}" "${_libraries}" PARENT_SCOPE)
endfunction()
