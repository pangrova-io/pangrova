+std::vector<std::shared_ptr<const Metadata>>
+SimpleFunctionRegistry::getFunctionMetadataSnapshot(
+    const std::string& name) const {
+  std::vector<std::shared_ptr<const Metadata>> result;
+  registeredFunctions_.withRLock([&](const auto& map) {
+    if (const auto* signatures = getSignatureMap(name, map)) {
+      for (const auto& entry : *signatures) {
+        for (const auto& implementation : entry.second) {
+          result.push_back(implementation->metadataSnapshot());
+        }
+      }
+    }
+  });
+  return result;
+}
