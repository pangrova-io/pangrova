new file mode 100644
index 0000000..9e18aaf
--- /dev/null
+++ b/velox/expression/FunctionRegistrySnapshot.h
@@ -0,0 +1,104 @@
+#pragma once
+
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+#include "velox/expression/SimpleFunctionRegistry.h"
+#include "velox/expression/FunctionSignature.h"
+#include "velox/expression/SpecialFormRegistry.h"
+#include "velox/expression/VectorFunction.h"
+
+namespace facebook::velox::exec {
+struct AggregateFunctionEntry;
+struct WindowFunctionEntry;
+
+class FunctionRegistrySnapshot final {
+ public:
+  struct ScalarEntry {
+    uint32_t implementationFamily;
+    uint32_t implementationPriority;
+    FunctionSignaturePtr signature;
+    std::shared_ptr<FunctionCallToSpecialForm> special;
+    std::shared_ptr<const VectorFunctionEntry> vector;
+    std::shared_ptr<const FunctionEntry> simple;
+    uint32_t family() const { return implementationFamily; }
+    uint32_t priority() const { return implementationPriority; }
+  };
+  struct BoundScalar {
+    ScalarEntry implementation;
+    TypePtr resultType;
+  };
+  struct BoundAggregate {
+    std::shared_ptr<const AggregateFunctionEntry> implementation;
+    AggregateFunctionSignaturePtr signature;
+    TypePtr resultType;
+    TypePtr intermediateType;
+  };
+  struct BoundWindow {
+    std::shared_ptr<const WindowFunctionEntry> implementation;
+    FunctionSignaturePtr signature;
+    TypePtr resultType;
+  };
+  using Scalars = std::unordered_map<std::string, std::vector<ScalarEntry>>;
+  using Vectors = std::unordered_map<std::string,
+      std::shared_ptr<const VectorFunctionEntry>>;
+  using Aggregates = std::unordered_map<std::string,
+      std::shared_ptr<const AggregateFunctionEntry>>;
+  using Windows = std::unordered_map<std::string,
+      std::shared_ptr<const WindowFunctionEntry>>;
+
+  FunctionRegistrySnapshot(Scalars scalars, Vectors vectors,
+      Aggregates aggregates, Windows windows)
+      : scalars_(std::move(scalars)), vectors_(std::move(vectors)),
+        aggregates_(std::move(aggregates)), windows_(std::move(windows)) {}
+
+  static std::shared_ptr<const FunctionRegistrySnapshot> capture();
+  const Scalars& scalars() const { return scalars_; }
+  const Vectors& vectors() const { return vectors_; }
+  const Aggregates& aggregates() const { return aggregates_; }
+  const Windows& windows() const { return windows_; }
+
+  std::optional<BoundScalar> bindScalar(
+      const std::string& name, const std::vector<TypePtr>& arguments,
+      const TypePtr& declaredTarget = nullptr) const;
+  std::optional<BoundAggregate> bindAggregate(
+      const std::string& name, const std::vector<TypePtr>& arguments) const;
+  std::optional<BoundWindow> bindWindow(
+      const std::string& name, const std::vector<TypePtr>& arguments) const;
+
+  ExprPtr compileCall(
+      const std::string& name, const TypePtr& result,
+      std::vector<ExprPtr> inputs, bool trackCpuUsage,
+      const core::QueryConfig& config, memory::MemoryPool* pool) const;
+  std::optional<std::pair<std::shared_ptr<VectorFunction>, VectorFunctionMetadata>>
+  vectorFunction(const std::string& name, const std::vector<TypePtr>& arguments,
+      const std::vector<VectorPtr>& constants, const core::QueryConfig& config) const;
+  static std::string_view executionSelectionContractSha256();
+
+  ExprPtr constructSpecial(
+      const std::string& name, const TypePtr& result,
+      std::vector<ExprPtr>&& inputs, bool trackCpuUsage,
+      const core::QueryConfig& config) const;
+
+  // Reads an exact registered companion entry. It does not perform scalar
+  // overload selection, synthesize a signature, or instantiate its factory.
+  std::shared_ptr<const VectorFunctionEntry> vectorCompanion(
+      const std::string& name) const;
+  std::shared_ptr<const AggregateFunctionEntry> aggregate(
+      const std::string& name) const;
+  std::shared_ptr<const WindowFunctionEntry> window(
+      const std::string& name) const;
+
+ private:
+  const Scalars scalars_;
+  const Vectors vectors_;
+  const Aggregates aggregates_;
+  const Windows windows_;
+};
+}  // namespace facebook::velox::exec
diff --git a/velox/expression/FunctionRegistryMutation.h b/velox/expression/FunctionRegistryMutation.h
new file mode 100644
index 0000000..559a593
--- /dev/null
+++ b/velox/expression/FunctionRegistryMutation.h
@@ -0,0 +1,20 @@
+#pragma once
+#include <mutex>
+#include <memory>
+
+namespace facebook::velox::exec {
+/// Exact process-local entry ownership. It is neither a digest nor authority.
+struct FunctionRegistrationOwner final {};
+
+/// Removes exact owned vector/aggregate/window entries without clearing names
+/// belonging to another incarnation or a later lawful registration.
+void unregisterOwnedFunctionEntries(
+    const std::shared_ptr<const FunctionRegistrationOwner>& owner);
+/// Short registry entry publication/capture transaction. Retired factory
+/// owners must be released after this lock and each registry map lock.
+/// This must never be held while invoking a function factory or user callback.
+inline std::recursive_mutex& functionRegistryMutationMutex() {
+  static std::recursive_mutex mutex;
+  return mutex;
+}
+} // namespace facebook::velox::exec
diff --git a/velox/expression/FunctionRegistrySnapshot.cpp b/velox/expression/FunctionRegistrySnapshot.cpp
new file mode 100644
index 0000000..c9d2bcc
--- /dev/null
+++ b/velox/expression/FunctionRegistrySnapshot.cpp
@@ -0,0 +1,145 @@
+#include "velox/expression/FunctionRegistrySnapshot.h"
+#include <algorithm>
+#include "ExecutionSelection.h"
+#include "velox/expression/ConstantExpr.h"
+#include "velox/expression/SignatureBinder.h"
+
+namespace facebook::velox::exec {
+namespace {
+std::optional<FunctionRegistrySnapshot::BoundScalar> bindEntry(
+    const FunctionRegistrySnapshot::ScalarEntry& entry,
+    const std::vector<TypePtr>& arguments, const TypePtr& declaredTarget) {
+  if (entry.special) {
+    // A registered special form is authoritative. A type error is not a
+    // non-match and must never fall through to another implementation.
+    return FunctionRegistrySnapshot::BoundScalar{
+        entry, entry.special->resolveDeclaredType(arguments, declaredTarget)};
+  }
+  SignatureBinder binder(*entry.signature, arguments);
+  if (!binder.tryBind()) {
+    return std::nullopt;
+  }
+  auto result = binder.tryResolveReturnType();
+  VELOX_CHECK_NOT_NULL(result);
+  if (entry.simple) {
+    const auto& metadata = entry.simple->getMetadata();
+    const auto count = std::min(arguments.size(), metadata.argPhysicalTypes().size());
+    for (size_t i = 0; i < count; ++i) {
+      if (!simpleFunctionPhysicalTypeMatches(arguments[i], metadata.argPhysicalTypes()[i])) {
+        return std::nullopt;
+      }
+    }
+    if (!simpleFunctionPhysicalTypeMatches(result, metadata.resultPhysicalType())) {
+      return std::nullopt;
+    }
+  }
+  return FunctionRegistrySnapshot::BoundScalar{entry, std::move(result)};
+}
+std::pair<std::shared_ptr<VectorFunction>, VectorFunctionMetadata> instantiateVector(
+    const std::string& name, const VectorFunctionEntry& entry,
+    const std::vector<TypePtr>& types, const std::vector<VectorPtr>& constants,
+    const core::QueryConfig& config) {
+  VELOX_CHECK(constants.empty() || constants.size() == types.size());
+  std::vector<VectorFunctionArg> arguments;
+  for (size_t i = 0; i < types.size(); ++i) {
+    arguments.push_back({types[i], constants.empty() ? nullptr : constants[i]});
+  }
+  auto function = entry.factory(sanitizeName(name), arguments, config);
+  VELOX_CHECK_NOT_NULL(function, "Selected function factory returned null: {}", name);
+  return {std::move(function), entry.metadata};
+}
+} // namespace
+
+std::string_view FunctionRegistrySnapshot::executionSelectionContractSha256() {
+  return pangrova::contract::generated::executionSelectionSha256;
+}
+
+std::optional<std::pair<std::shared_ptr<VectorFunction>, VectorFunctionMetadata>>
+FunctionRegistrySnapshot::vectorFunction(
+    const std::string& name, const std::vector<TypePtr>& arguments,
+    const std::vector<VectorPtr>& constants, const core::QueryConfig& config) const {
+  const auto selected = bindScalar(name, arguments);
+  if (!selected || !selected->implementation.vector) {
+    return std::nullopt;
+  }
+  return instantiateVector(name, *selected->implementation.vector, arguments, constants, config);
+}
+
+std::optional<FunctionRegistrySnapshot::BoundScalar>
+FunctionRegistrySnapshot::bindScalar(
+    const std::string& name, const std::vector<TypePtr>& arguments,
+    const TypePtr& declaredTarget) const {
+  const auto found = scalars_.find(sanitizeName(name));
+  if (found == scalars_.end()) {
+    return std::nullopt;
+  }
+  return pangrova::contract::generated::selectExecution<BoundScalar>(
+      std::span<const ScalarEntry>(found->second),
+      [&](const ScalarEntry& entry) { return bindEntry(entry, arguments, declaredTarget); });
+}
+
+ExprPtr FunctionRegistrySnapshot::constructSpecial(
+    const std::string& name, const TypePtr& result, std::vector<ExprPtr>&& inputs,
+    bool trackCpuUsage, const core::QueryConfig& config) const {
+  const auto found = scalars_.find(sanitizeName(name));
+  if (found == scalars_.end() || found->second.empty() || !found->second.front().special) {
+    return nullptr;
+  }
+  std::vector<TypePtr> types;
+  for (const auto& input : inputs) types.push_back(input->type());
+  const auto resolved = found->second.front().special->resolveDeclaredType(types, result);
+  VELOX_USER_CHECK(result->equivalent(*resolved),
+      "Special form declared result differs from its owned type program: {}", name);
+  return found->second.front().special->constructSpecialForm(
+      result, std::move(inputs), trackCpuUsage, config);
+}
+
+ExprPtr FunctionRegistrySnapshot::compileCall(
+    const std::string& name, const TypePtr& result, std::vector<ExprPtr> inputs,
+    bool trackCpuUsage, const core::QueryConfig& config, memory::MemoryPool* pool) const {
+  std::vector<TypePtr> types;
+  std::vector<VectorPtr> constants;
+  for (const auto& input : inputs) {
+    types.push_back(input->type());
+    constants.push_back(input->isConstant()
+        ? dynamic_cast<const ConstantExpr&>(*input).value() : nullptr);
+  }
+  auto bound = bindScalar(name, types, result);
+  VELOX_USER_CHECK(bound.has_value(),
+      "Function not present in the owned registry snapshot: {}", name);
+  VELOX_USER_CHECK(result->equivalent(*bound->resultType),
+      "Selected implementation return type differs for {}: {} vs {}",
+      name, bound->resultType->toString(), result->toString());
+  const auto& implementation = bound->implementation;
+  if (implementation.special) {
+    return implementation.special->constructSpecialForm(
+        result, std::move(inputs), trackCpuUsage, config);
+  }
+  std::shared_ptr<VectorFunction> function;
+  VectorFunctionMetadata metadata;
+  if (implementation.vector) {
+    auto selected = instantiateVector(name, *implementation.vector, types, constants, config);
+    function = std::move(selected.first);
+    metadata = selected.second;
+  } else {
+    SimpleFunctionRegistry::ResolvedSimpleFunction selected(
+        implementation.simple, bound->resultType);
+    function = selected.createFunction()->createVectorFunction(types, constants, config, pool);
+    metadata = selected.metadata();
+  }
+  VELOX_CHECK_NOT_NULL(function, "Selected function factory returned null: {}", name);
+  return std::make_shared<Expr>(result, std::move(inputs), std::move(function),
+      metadata, sanitizeName(name), trackCpuUsage);
+}
