+++ b/velox/exec/FunctionRegistrySnapshot.cpp
@@ -0,0 +1,52 @@
+#include "velox/expression/FunctionRegistrySnapshot.h"
+
+#include "velox/exec/Aggregate.h"
+#include "velox/exec/WindowFunction.h"
+#include "velox/expression/FunctionRegistryMutation.h"
+
+#include <mutex>
+#include <utility>
+
+namespace facebook::velox::exec {
+
+std::shared_ptr<const FunctionRegistrySnapshot> FunctionRegistrySnapshot::capture() {
+  std::lock_guard mutation(functionRegistryMutationMutex());
+  Scalars scalars;
+  for (const auto& [name, special] : specialFormRegistry().entriesSnapshot()) {
+    scalars[name].push_back(ScalarEntry{1, 0, nullptr, special, nullptr, nullptr});
+  }
+  Vectors vectors;
+  vectorFunctionFactories().withRLock([&](const auto& map) {
+    for (const auto& [name, entry] : map) {
+      auto owned = std::make_shared<const VectorFunctionEntry>(entry);
+      // A real signature-less companion still owns its factory and metadata.
+      // Scalar entries and companion access retain the same allocation.
+      vectors.emplace(name, owned);
+      for (const auto& signature : owned->signatures) {
+        scalars[name].push_back(ScalarEntry{2, 0, signature, nullptr, owned, nullptr});
+      }
+    }
+  });
+  for (const auto& [name, entries] : simpleFunctions().entriesSnapshot()) {
+    for (const auto& entry : entries) {
+      const auto& metadata = entry->getMetadata();
+      scalars[name].push_back(ScalarEntry{
+          3, metadata.priority(), metadata.signature(), nullptr, nullptr, entry});
+    }
+  }
+  Aggregates aggregates;
+  aggregateFunctions().withRLock([&](const auto& map) {
+    for (const auto& [name, entry] : map) {
+      aggregates.emplace(name, std::make_shared<const AggregateFunctionEntry>(entry));
+    }
+  });
+  Windows windows;
+  for (const auto& [name, entry] : windowFunctions()) {
+    windows.emplace(name, std::make_shared<const WindowFunctionEntry>(entry));
+  }
+  return std::make_shared<const FunctionRegistrySnapshot>(
+      std::move(scalars), std::move(vectors),
+      std::move(aggregates), std::move(windows));
+}
+
+}  // namespace facebook::velox::exec
