diff --git a/velox/exec/FunctionRegistrySnapshotBindings.cpp b/velox/exec/FunctionRegistrySnapshotBindings.cpp
new file mode 100644
index 0000000..dc4991a
--- /dev/null
+++ b/velox/exec/FunctionRegistrySnapshotBindings.cpp
@@ -0,0 +1,91 @@
+#include "velox/expression/FunctionRegistrySnapshot.h"
+
+#include "velox/exec/Aggregate.h"
+#include "velox/exec/WindowFunction.h"
+#include "velox/expression/SignatureBinder.h"
+#include "velox/expression/FunctionRegistryMutation.h"
+
+#include <utility>
+#include <mutex>
+#include <type_traits>
+
+namespace facebook::velox::exec {
+
+namespace {
+template <typename Map, typename Entry>
+void retireOwnedEntries(Map& entries,
+    const std::shared_ptr<const FunctionRegistrationOwner>& owner,
+    std::vector<Entry>& retired) {
+  static_assert(std::is_nothrow_move_constructible_v<Entry>);
+  for (auto entry = entries.begin(); entry != entries.end();) {
+    if (entry->second.registrationOwner != owner) {
+      ++entry;
+      continue;
+    }
+    retired.push_back(std::move(entry->second));
+    entry = entries.erase(entry);
+  }
+}
+} // namespace
+
+void unregisterOwnedFunctionEntries(
+    const std::shared_ptr<const FunctionRegistrationOwner>& owner) {
+  VELOX_CHECK_NOT_NULL(owner);
+  // Outer retirement owners outlive the global mutation and all map locks.
+  std::vector<VectorFunctionEntry> vectors;
+  std::vector<AggregateFunctionEntry> aggregates;
+  std::vector<WindowFunctionEntry> windows;
+  {
+    std::lock_guard mutation(functionRegistryMutationMutex());
+    // Complete every allocation before moving the first published entry.
+    vectorFunctionFactories().withRLock([&](const auto& map) { vectors.reserve(map.size()); });
+    aggregateFunctions().withRLock([&](const auto& map) { aggregates.reserve(map.size()); });
+    windows.reserve(windowFunctions().size());
+    vectorFunctionFactories().withWLock([&](auto& map) { retireOwnedEntries(map, owner, vectors); });
+    aggregateFunctions().withWLock([&](auto& map) { retireOwnedEntries(map, owner, aggregates); });
+    retireOwnedEntries(windowFunctions(), owner, windows);
+  }
+}
+
+std::optional<FunctionRegistrySnapshot::BoundAggregate>
+FunctionRegistrySnapshot::bindAggregate(
+    const std::string& name, const std::vector<TypePtr>& arguments) const {
+  const auto implementation = aggregate(name);
+  if (!implementation) return std::nullopt;
+  for (const auto& signature : implementation->signatures) {
+    SignatureBinder binder(*signature, arguments);
+    if (!binder.tryBind()) continue;
+    auto result = binder.tryResolveReturnType();
+    auto intermediate = binder.tryResolveType(signature->intermediateType());
+    // Binding succeeded: unresolved output/state is an error in this entry,
+    // not permission to search a later overload by the desired output.
+    VELOX_CHECK_NOT_NULL(result);
+    VELOX_CHECK_NOT_NULL(intermediate);
+    return BoundAggregate{implementation, signature,
+        std::move(result), std::move(intermediate)};
+  }
+  return std::nullopt;
+}
+
+std::optional<FunctionRegistrySnapshot::BoundWindow>
+FunctionRegistrySnapshot::bindWindow(
+    const std::string& name, const std::vector<TypePtr>& arguments) const {
+  const auto implementation = window(name);
+  if (!implementation) return std::nullopt;
+  for (const auto& signature : implementation->signatures) {
+    SignatureBinder binder(*signature, arguments);
+    if (!binder.tryBind()) continue;
+    auto result = binder.tryResolveReturnType();
+    VELOX_CHECK_NOT_NULL(result);
+    return BoundWindow{implementation, signature, std::move(result)};
+  }
+  return std::nullopt;
+}
+
+std::shared_ptr<const VectorFunctionEntry>
+FunctionRegistrySnapshot::vectorCompanion(const std::string& name) const {
+  const auto found = vectors_.find(sanitizeName(name));
+  return found == vectors_.end() ? nullptr : found->second;
+}
+
+}  // namespace facebook::velox::exec
