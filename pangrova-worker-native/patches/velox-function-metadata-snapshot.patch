+std::shared_ptr<const AggregateFunctionEntry>
+FunctionRegistrySnapshot::aggregate(const std::string& name) const {
+  const auto found = aggregates_.find(sanitizeName(name));
+  return found == aggregates_.end() ? nullptr : found->second;
+}
+std::shared_ptr<const WindowFunctionEntry>
+FunctionRegistrySnapshot::window(const std::string& name) const {
+  const auto found = windows_.find(sanitizeName(name));
+  return found == windows_.end() ? nullptr : found->second;
+}
