<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.pangrova</groupId>
        <artifactId>pangrova-worker</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>pangrova-worker-native-bridge</artifactId>
    <name>Pangrova Worker Native Bridge</name>
    <description>JNI bridge, native library loader, and native callback contracts shared by Worker and AI worker</description>

    <properties>
        <module.name>org.pangrova.worker.nativebridge</module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-protocol</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-function</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-connector-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-connector-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.arrow</groupId>
            <artifactId>arrow-memory-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-observability-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-testing-kit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>native-bridge-test-fixtures</id>
                        <phase>test-compile</phase>
                        <goals><goal>test-jar</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>native-required</excludedGroups>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
