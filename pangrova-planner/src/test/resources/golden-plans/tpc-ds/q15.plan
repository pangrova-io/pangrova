LogicalSort(sort0=[$0], dir0=[ASC], fetch=[100])
  LogicalAggregate(group=[{3}], total_sales=[SUM($1)])
    LogicalFilter(condition=[AND(OR(SEARCH(SUBSTRING($3, 1:BIGINT, 5:BIGINT), Sarg['80348':VARCHAR, '81792':VARCHAR, '83405':VARCHAR, '85392':VARCHAR, '85460':VARCHAR, '85669':VARCHAR, '86197':VARCHAR, '86475':VARCHAR, '88274':VARCHAR]:VARCHAR), SEARCH($2, Sarg['CA':VARCHAR, 'GA':VARCHAR, 'WA':VARCHAR]:VARCHAR), >(CAST($1):DECIMAL(12, 2) NOT NULL, 500.00)), =($6, 2), =($5, 2001))])
      LogicalJoin(condition=[=($0, $4)], joinType=[inner])
