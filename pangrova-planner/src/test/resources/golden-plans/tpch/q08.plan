LogicalProject(o_year=[$0], mkt_share=[/($1, $2)])
  LogicalSort(sort0=[$0], dir0=[ASC])
    LogicalAggregate(group=[{0}], agg#0=[$SUM0($1)], agg#1=[$SUM0($2)])
      LogicalProject(o_year=[EXTRACT(FLAG(YEAR), $11)], $f1=[CASE(=($17, 'BRAZIL'), *($7, -(1, $8)), 0:DECIMAL(19, 4))], volume=[*($7, -(1, $8))])
        LogicalJoin(condition=[=($15, $18)], joinType=[inner])
          LogicalJoin(condition=[=($3, $16)], joinType=[inner])
            LogicalJoin(condition=[=($13, $14)], joinType=[inner])
              LogicalJoin(condition=[=($10, $12)], joinType=[inner])
                LogicalJoin(condition=[=($4, $9)], joinType=[inner])
                  LogicalJoin(condition=[AND(=($0, $5), =($2, $6))], joinType=[inner])
                    LogicalJoin(condition=[true], joinType=[inner])
                      LogicalProject(P_PARTKEY=[$0], P_TYPE=[$4])
                        LogicalFilter(condition=[=($4, 'ECONOMY ANODIZED STEEL')])
                          LogicalTableScan(table=[[part]])
                      LogicalProject(S_SUPPKEY=[$0], S_NATIONKEY=[$3])
                        LogicalTableScan(table=[[supplier]])
                    LogicalProject(L_ORDERKEY=[$0], L_PARTKEY=[$1], L_SUPPKEY=[$2], L_EXTENDEDPRICE=[$5], L_DISCOUNT=[$6])
                      LogicalTableScan(table=[[lineitem]])
                  LogicalProject(O_ORDERKEY=[$0], O_CUSTKEY=[$1], O_ORDERDATE=[$4])
                    LogicalFilter(condition=[SEARCH($4, Sarg[[1995-01-01..1996-12-31]])])
                      LogicalTableScan(table=[[orders]])
                LogicalProject(C_CUSTKEY=[$0], C_NATIONKEY=[$3])
                  LogicalTableScan(table=[[customer]])
              LogicalProject(N_NATIONKEY=[$0], N_REGIONKEY=[$2])
                LogicalTableScan(table=[[nation]])
            LogicalProject(N_NATIONKEY=[$0], N_NAME=[$1])
              LogicalTableScan(table=[[nation]])
          LogicalProject(R_REGIONKEY=[$0], R_NAME=[$1])
            LogicalFilter(condition=[=($1, 'AMERICA')])
              LogicalTableScan(table=[[region]])
