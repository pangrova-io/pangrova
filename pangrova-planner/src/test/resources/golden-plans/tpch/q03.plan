LogicalProject(l_orderkey=[$0], revenue=[$3], o_orderdate=[$1], o_shippriority=[$2])
  LogicalSort(sort0=[$3], sort1=[$1], dir0=[DESC], dir1=[ASC])
    LogicalAggregate(group=[{0, 1, 2}], revenue=[SUM($3)])
      LogicalProject(l_orderkey=[$6], o_orderdate=[$4], o_shippriority=[$5], $f3=[*($7, -(1, $8))])
        LogicalJoin(condition=[=($6, $2)], joinType=[inner])
          LogicalJoin(condition=[=($0, $3)], joinType=[inner])
            LogicalProject(C_CUSTKEY=[$0], C_MKTSEGMENT=[$6])
              LogicalFilter(condition=[=($6, 'BUILDING')])
                LogicalTableScan(table=[[customer]])
            LogicalProject(O_ORDERKEY=[$0], O_CUSTKEY=[$1], O_ORDERDATE=[$4], O_SHIPPRIORITY=[$7])
              LogicalFilter(condition=[<($4, 1995-03-15)])
                LogicalTableScan(table=[[orders]])
          LogicalProject(L_ORDERKEY=[$0], L_EXTENDEDPRICE=[$5], L_DISCOUNT=[$6], L_SHIPDATE=[$10])
            LogicalFilter(condition=[>($10, 1995-03-15)])
              LogicalTableScan(table=[[lineitem]])
