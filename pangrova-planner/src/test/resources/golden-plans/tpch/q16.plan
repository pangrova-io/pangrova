LogicalSort(sort0=[$3], sort1=[$0], sort2=[$1], sort3=[$2], dir0=[DESC], dir1=[ASC], dir2=[ASC], dir3=[ASC])
  LogicalAggregate(group=[{3, 4, 5}], supplier_cnt=[COUNT(DISTINCT $1)])
    LogicalFilter(condition=[AND(=($2, $0), <>($3, _UTF-8'Brand#45'), SEARCH($5, Sarg[3, 9, 14, 19, 23, 36, 45, 49]), IS NULL($7), NOT(LIKE($4, _UTF-8'MEDIUM POLISHED%')))])
      LogicalJoin(condition=[=($1, $6)], joinType=[left])
        LogicalJoin(condition=[true], joinType=[inner])
          LogicalProject(PS_PARTKEY=[$0], PS_SUPPKEY=[$1])
            LogicalTableScan(table=[[partsupp]])
          LogicalProject(P_PARTKEY=[$0], P_BRAND=[$3], P_TYPE=[$4], P_SIZE=[$5])
            LogicalTableScan(table=[[part]])
        LogicalProject(s_suppkey=[$0], i=[$1])
          LogicalAggregate(group=[{0}], i=[LITERAL_AGG(true)])
            LogicalFilter(condition=[LIKE($6, _UTF-8'%Customer%Complaints%')])
              LogicalTableScan(table=[[supplier]])
