LogicalProject(revenue=[CASE(=($1, 0), null:DECIMAL(19, 4), $0)])
  LogicalAggregate(group=[{}], revenue=[$SUM0($0)], agg#1=[COUNT()])
    LogicalProject($f0=[*($1, $2)])
      LogicalProject(L_QUANTITY=[$4], L_EXTENDEDPRICE=[$5], L_DISCOUNT=[$6], L_SHIPDATE=[$10])
        LogicalFilter(condition=[AND(SEARCH($10, Sarg[[1994-01-01..1995-01-01)]), SEARCH($6, Sarg[[0.05:DECIMAL(3, 2)..0.07:DECIMAL(3, 2)]]:DECIMAL(3, 2)), <($4, 24))])
          LogicalTableScan(table=[[lineitem]])
