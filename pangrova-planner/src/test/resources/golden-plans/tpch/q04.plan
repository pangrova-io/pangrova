          LogicalFilter(condition=[AND(=($0, $cor0.O_ORDERKEY), <($1, $2))])
            LogicalProject(L_ORDERKEY=[$0], L_COMMITDATE=[$11], L_RECEIPTDATE=[$12])
              LogicalTableScan(table=[[lineitem]])
