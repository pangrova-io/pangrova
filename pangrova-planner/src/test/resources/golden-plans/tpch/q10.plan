  LogicalSort(sort0=[$7], dir0=[DESC], fetch=[20])
    LogicalAggregate(group=[{0, 1, 2, 3, 4, 5, 6}], revenue=[SUM($7)])
      LogicalProject(c_custkey=[$0], c_name=[$1], c_acctbal=[$5], c_phone=[$4], n_name=[$15], c_address=[$2], c_comment=[$6], $f7=[*($11, -(1, $12))])
        LogicalJoin(condition=[=($3, $14)], joinType=[inner])
          LogicalJoin(condition=[=($10, $7)], joinType=[inner])
            LogicalJoin(condition=[=($0, $8)], joinType=[inner])
              LogicalProject(C_CUSTKEY=[$0], C_NAME=[$1], C_ADDRESS=[$2], C_NATIONKEY=[$3], C_PHONE=[$4], C_ACCTBAL=[$5], C_COMMENT=[$7])
