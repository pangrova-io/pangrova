<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.pangrova</groupId>
        <artifactId>pangrova-bom</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>pangrova-planner</artifactId>
    <name>Pangrova Planner</name>
    <description>Calcite-based query planner with custom optimization rules</description>

    <dependencies>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-shuffle-core</artifactId>
        </dependency>        <!-- Internal module dependencies (versions inherited from parent) -->
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-parser</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-protocol</artifactId>
        </dependency>

        <!-- Calcite core -->
        <dependency>
            <groupId>org.apache.calcite</groupId>
            <artifactId>calcite-core</artifactId>
        </dependency>

        <!-- Substrait Java SDK core (transferred from pangrova-substrait) -->
        <dependency>
            <groupId>io.substrait</groupId>
            <artifactId>core</artifactId>
        </dependency>

        <!-- Guava (for RateLimiter in throttling) -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>

        <!-- PERF-T7: Caffeine cache for lock-free PlanCache (version managed by parent BOM) -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-test-common</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Test dependencies (versions inherited from parent) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
