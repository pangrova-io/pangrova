LogicalSort(sort0=[$1], dir0=[DESC])
  LogicalAggregate(group=[{0}], revenue=[$SUM0($1)])
    LogicalProject(n_name=[$12], $f1=[*($7, -(1, $8))])
      LogicalJoin(condition=[=($13, $14)], joinType=[inner])
        LogicalJoin(condition=[=($10, $11)], joinType=[inner])
          LogicalJoin(condition=[AND(=($6, $9), =($1, $10))], joinType=[inner])
            LogicalJoin(condition=[=($5, $2)], joinType=[inner])
              LogicalJoin(condition=[=($0, $3)], joinType=[inner])
                LogicalProject(C_CUSTKEY=[$0], C_NATIONKEY=[$3])
                  LogicalTableScan(table=[[customer]])
                LogicalProject(O_ORDERKEY=[$0], O_CUSTKEY=[$1], O_ORDERDATE=[$4])
                  LogicalFilter(condition=[SEARCH($4, Sarg[[1994-01-01..1995-01-01)])])
                    LogicalTableScan(table=[[orders]])
              LogicalProject(L_ORDERKEY=[$0], L_SUPPKEY=[$2], L_EXTENDEDPRICE=[$5], L_DISCOUNT=[$6])
