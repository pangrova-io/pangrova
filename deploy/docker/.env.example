# ============================================================
# Pangrova Docker Compose — Environment Variables
#
# Copy this file to `.env` in the same directory:
#   cp .env.example .env
#
# Docker Compose automatically loads `.env` when present.
# ============================================================

# ── Image ──────────────────────────────────────────────────
PANGROVA_VERSION=latest

# ── JVM Memory ─────────────────────────────────────────────
# Coordinator: modest heap for planning and metadata
COORDINATOR_JAVA_OPTS=-Xms2g -Xmx8g -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError

# Worker: larger heap + Arrow off-heap for execution
WORKER_JAVA_OPTS=-Xms2g -Xmx16g -XX:MaxDirectMemorySize=4g -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError

# ── Object Storage — AWS S3 ────────────────────────────────
# Uncomment and fill in for S3-based data lakes:
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# ── Object Storage — Alibaba Cloud OSS ─────────────────────
# Uncomment and fill in for OSS-based data lakes:
# ALIBABA_CLOUD_ACCESS_KEY_ID=LTAI5tXXXXXXXXXXXX
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
# PANGROVA_OSS_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
# PANGROVA_OSS_REGION=cn-hangzhou
# PANGROVA_OSS_BUCKET=my-lakehouse-bucket

# ── Object Storage — MinIO (S3-Compatible) ─────────────────
# Pre-configured for the MinIO service in docker-compose.
# These work with docker-compose-with-minio.yml:
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# PANGROVA_MINIO_ENDPOINT=http://minio:9000
# PANGROVA_MINIO_BUCKET=pangrova-data

# ── Security ───────────────────────────────────────────────
# Internal cluster auth secret (all nodes must share this).
# Generate with: openssl rand -base64 48
# PANGROVA_INTERNAL_AUTH_SECRET=<generate-me>
# ============================================================
# Pangrova Docker Compose — Environment Variables
# Copy this file to .env and adjust values for your environment.
#
# Usage: cp .env.example .env && vi .env
# ============================================================

# ---- Image Configuration ----
# Pangrova container image version tag
PANGROVA_VERSION=latest

# ---- Coordinator Configuration ----
# Host port mapped to Coordinator HTTP (default: 8080)
COORDINATOR_PORT=8080

# Coordinator JVM options
# Production: increase heap for large metadata cache
COORDINATOR_JAVA_OPTS=-Xms2g -Xmx8g

# Coordinator node ID (must be unique per coordinator in cluster mode)
# COORDINATOR_ID=coordinator-1

# ---- Worker Configuration ----
# Host port mapped to Worker HTTP (default: 8081)
WORKER_PORT=8081

# Worker JVM options (includes Arrow off-heap memory)
# Production: increase -Xmx and MaxDirectMemorySize based on node RAM
WORKER_JAVA_OPTS=-Xms2g -Xmx16g -XX:MaxDirectMemorySize=4g

# Worker node ID (must be unique per worker)
# WORKER_ID=worker-1

# Coordinator URL for worker registration
# Only needed for cluster mode; single-node compose sets this automatically
# WORKER_COORDINATOR_URL=http://coordinator:8080

# ---- Logging ----
# Log level override (default: INFO)
# PANGROVA_LOG_LEVEL=DEBUG

# ---- Security ----
# Internal authentication secret (shared between Coordinator and Workers)
# PANGROVA_INTERNAL_AUTH_SECRET=change-me-in-production

# ---- Observability ----
# OpenTelemetry Collector endpoint
# OTEL_ENDPOINT=http://otel-collector:4317
