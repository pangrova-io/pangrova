# Docker Compose development environment. Copy to .env and fill the two required
# values before starting either Compose profile. Do not commit the populated .env.

# Use a unique password for the bundled PostgreSQL service.
PANGROVA_DB_PASSWORD=

# Shared Coordinator/Worker control-plane secret. Generate with:
#   openssl rand -base64 48
PANGROVA_INTERNAL_AUTH_SECRET=

# Image and host ports.
PANGROVA_VERSION=latest
COORDINATOR_PORT=8080
WORKER_PORT=8081

# Optional JVM sizing overrides for the Compose development profile.
# COORDINATOR_JAVA_OPTS=-Xms128m -Xmx512m
# WORKER_JAVA_OPTS=-Xms128m -Xmx384m -XX:MaxDirectMemorySize=128m

# Optional object-store credentials for a connector used by this cluster.
# AWS_REGION=your-region
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_ENDPOINT_URL=https://your-endpoint
# PANGROVA_OSS_ENDPOINT=https://your-oss-endpoint
# PANGROVA_OSS_REGION=your-region
