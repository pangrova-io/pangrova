package org.pangrova.connector.paimon;

import org.apache.paimon.table.source.Split;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;

import java.time.Duration;
import java.util.OptionalLong;

import static org.assertj.core.api.Assertions.assertThat;
import static org.assertj.core.api.Assertions.assertThatThrownBy;

/**
 * Tests for {@link PaimonSplitRegistry} state machine (F-PAIMON-06).
 *
 * <p>Verifies:
 * <ul>
 *   <li>Consumed splits cannot be re-read (throws, not empty)</li>
 *   <li>Unknown/invalidated splits throw on consume (not silently return null)</li>
 *   <li>Native-only sentinel throws a clear error if JVM path is invoked</li>
 *   <li>Lifecycle cleanup (invalidate, clear) works correctly</li>
 * </ul>
 */
class PaimonSplitRegistryTest {

    private PaimonSplitRegistry registry;

    @BeforeEach
    void setUp() {
        registry = new PaimonSplitRegistry();
    }

    @Test
    void consume_returnsRegisteredSplit() {
        Split split = new StubSplit(42);
        long id = registry.register(split);

        Split result = registry.consume(id);

        assertThat(result).isSameAs(split);
        assertThat(registry.isConsumed(id)).isTrue();
        assertThat(registry.isPending(id)).isFalse();
    }

    @Test
    void consume_alreadyConsumed_throwsWithClearMessage() {
        Split split = new StubSplit(10);
        long id = registry.register(split);
        registry.consume(id);

        assertThatThrownBy(() -> registry.consume(id))
                .isInstanceOf(IllegalStateException.class)
                .hasMessageContaining("already consumed")
                .hasMessageContaining(String.valueOf(id));
    }

    @Test
    void consume_neverRegistered_throwsWithClearMessage() {
        long bogusId = 999_999L;

        assertThatThrownBy(() -> registry.consume(bogusId))
                .isInstanceOf(IllegalStateException.class)
                .hasMessageContaining("No Paimon SDK Split registered")
                .hasMessageContaining(String.valueOf(bogusId));
    }

    @Test
    void consume_afterInvalidate_throwsNotFoundError() {
        Split split = new StubSplit(5);
        long id = registry.register(split);

        registry.invalidate(id);

        assertThatThrownBy(() -> registry.consume(id))
                .isInstanceOf(IllegalStateException.class)
                .hasMessageContaining("No Paimon SDK Split registered");
    }

    @Test
    void consume_nativeOnlySentinel_throwsClearError() {
        assertThatThrownBy(() -> registry.consume(PaimonSplitRegistry.NO_REGISTRY_ENTRY))
                .isInstanceOf(IllegalStateException.class)
                .hasMessageContaining("native-only split")
                .hasMessageContaining("JVM read path should not be invoked");
    }

    @Test
    void invalidate_removesFromPendingAndConsumed() {
        Split split = new StubSplit(1);
        long id = registry.register(split);
        assertThat(registry.isPending(id)).isTrue();

        registry.invalidate(id);

        assertThat(registry.isPending(id)).isFalse();
        assertThat(registry.isConsumed(id)).isFalse();
    }

    @Test
    void invalidate_consumedSplit_removesConsumedRecord() {
        Split split = new StubSplit(1);
        long id = registry.register(split);
        registry.consume(id);
        assertThat(registry.isConsumed(id)).isTrue();

        registry.invalidate(id);

        assertThat(registry.isConsumed(id)).isFalse();
    }

    @Test
    void clear_removesAllState() {
        Split s1 = new StubSplit(1);
        Split s2 = new StubSplit(2);
        long id1 = registry.register(s1);
        long id2 = registry.register(s2);
        registry.consume(id1); // id1 -> consumed, id2 -> pending

        registry.clear();

        assertThat(registry.size()).isZero();
        assertThat(registry.isPending(id2)).isFalse();
        assertThat(registry.isConsumed(id1)).isFalse();
    }

    @Test
    void size_tracksOnlyPendingSplits() {
        Split s1 = new StubSplit(1);
        Split s2 = new StubSplit(2);
        long id1 = registry.register(s1);
        registry.register(s2);

        assertThat(registry.size()).isEqualTo(2);

        registry.consume(id1);
        assertThat(registry.size()).isEqualTo(1);
    }

    @Test
    void register_multipleSplits_assignsUniqueIds() {
        Split s1 = new StubSplit(1);
        Split s2 = new StubSplit(2);
        long id1 = registry.register(s1);
        long id2 = registry.register(s2);

        assertThat(id1).isNotEqualTo(id2);
        assertThat(registry.consume(id1)).isSameAs(s1);
        assertThat(registry.consume(id2)).isSameAs(s2);
    }

    @Test
    void deprecatedConstructor_stillWorks() {
        // Ensures tests using the old constructor signature don't break
        PaimonSplitRegistry legacyRegistry = new PaimonSplitRegistry(100, Duration.ofMinutes(5));
        Split split = new StubSplit(7);
        long id = legacyRegistry.register(split);
        assertThat(legacyRegistry.consume(id)).isSameAs(split);
    }

    /**
     * Minimal Split implementation for unit testing.
     */
    private static class StubSplit implements Split {
        private final long rows;

        StubSplit(long rows) {
            this.rows = rows;
        }

        @Override
        public long rowCount() {
            return rows;
        }

        @Override
        public OptionalLong mergedRowCount() {
            return OptionalLong.of(rows);
        }
    }
}
