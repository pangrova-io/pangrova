+  static ValueReader<ByteBuffer> fixed(int length) {
+    return new ValueReader<>() {
+      private final ValueReader<byte[]> bytesReader = ValueReaders.fixed(length);
+
+      @Override
+      public ByteBuffer read(Decoder decoder, Object reuse) throws IOException {
+        if (reuse instanceof ByteBuffer) {
+          ByteBuffer buffer = (ByteBuffer) reuse;
+          if (buffer.hasArray() && buffer.arrayOffset() == 0 && buffer.capacity() == length) {
+            bytesReader.read(decoder, buffer.array());
+            buffer.clear();
+            return buffer;
+          }
+        }
+        return ByteBuffer.wrap(bytesReader.read(decoder, null));
+      }
+
+      @Override
+      public void skip(Decoder decoder) throws IOException {
+        bytesReader.skip(decoder);
+      }
+    };
+  }
