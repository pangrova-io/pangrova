+  private static String currentCatalog(Connection conn, DatabaseMetaData metadata)
+      throws SQLException {
+    return metadata.supportsCatalogsInTableDefinitions() ? conn.getCatalog() : null;
+  }
+
+  private static String currentSchema(Connection conn, DatabaseMetaData metadata)
+      throws SQLException {
+    return metadata.supportsSchemasInTableDefinitions() ? conn.getSchema() : null;
+  }
+
+  private static String exactMetadataPattern(DatabaseMetaData metadata, String identifier)
+      throws SQLException {
+    if (identifier == null) {
+      return null;
+    }
+
+    String escape = metadata.getSearchStringEscape();
+    if (escape == null || escape.isEmpty()) {
+      // Drivers without pattern escaping still require exact result-row validation.
+      return identifier;
+    }
+
+    return identifier
+        .replace(escape, escape + escape)
+        .replace("_", escape + "_")
+        .replace("%", escape + "%");
+  }
+
+  private static boolean tableExists(
+      DatabaseMetaData metadata, String catalog, String schema, String name) throws SQLException {
+    if (exactTableExists(metadata, catalog, schema, name)) {
+      return true;
+    }
+
+    // Some databases fold unquoted identifiers to upper case.
+    return exactTableExists(metadata, catalog, schema, name.toUpperCase(Locale.ROOT));
   }
 
+  private static boolean exactTableExists(
+      DatabaseMetaData metadata, String catalog, String schema, String name) throws SQLException {
+    try (ResultSet result =
+        metadata.getTables(
+            catalog,
+            exactMetadataPattern(metadata, schema),
+            exactMetadataPattern(metadata, name),
+            null)) {
+      return exactObjectExists(result, catalog, schema, name, null);
+    }
+  }
+
+  private static boolean exactObjectExists(
+      ResultSet rows, String catalog, String schema, String table, String column)
+      throws SQLException {
+    while (rows.next()) {
+      if ((catalog == null || catalog.equals(rows.getString("TABLE_CAT")))
+          && (schema == null || schema.equals(rows.getString("TABLE_SCHEM")))
+          && table.equals(rows.getString("TABLE_NAME"))
+          && (column == null || column.equals(rows.getString("COLUMN_NAME")))) {
+        return true;
+      }
+    }
+
+    return false;
+  }
