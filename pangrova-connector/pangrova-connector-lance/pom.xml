<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>org.pangrova</groupId><artifactId>pangrova-connector</artifactId><version>0.1.0-SNAPSHOT</version></parent>
    <artifactId>pangrova-connector-lance</artifactId>
    <name>Pangrova Connector Lance</name>
    <properties>
        <module.name>org.pangrova.connector.lance</module.name>
    </properties>

    <dependencies>
        <dependency><groupId>org.pangrova</groupId><artifactId>pangrova-persistence-workflow-postgresql</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.pangrova</groupId><artifactId>pangrova-execution-api</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.pangrova</groupId><artifactId>pangrova-persistence-catalog-postgresql</artifactId><scope>test</scope></dependency>

        <dependency><groupId>org.pangrova</groupId><artifactId>pangrova-metadata-api</artifactId><scope>test</scope></dependency>

        <dependency><groupId>org.pangrova</groupId><artifactId>pangrova-persistence-query-postgresql</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.pangrova</groupId><artifactId>pangrova-security-codec</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.pangrova</groupId><artifactId>pangrova-persistence-security-postgresql</artifactId><scope>test</scope></dependency>
  <dependency><groupId>org.pangrova</groupId><artifactId>pangrova-security-api</artifactId><scope>test</scope></dependency>

        <dependency><groupId>org.pangrova</groupId><artifactId>pangrova-persistence-jdbc-api</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.pangrova</groupId><artifactId>pangrova-persistence-query-api</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.pangrova</groupId><artifactId>pangrova-connector-api</artifactId></dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-types</artifactId>
        </dependency>


        <dependency><groupId>org.pangrova</groupId><artifactId>pangrova-common</artifactId></dependency>
        <dependency><groupId>org.pangrova</groupId><artifactId>pangrova-protocol</artifactId></dependency>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
        <dependency><groupId>org.pangrova</groupId><artifactId>pangrova-metadata-catalog</artifactId><scope>test</scope></dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-metadata-catalog</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <classifier>tests</classifier>
            <scope>test</scope>
        </dependency>
        <dependency><groupId>org.pangrova</groupId><artifactId>pangrova-query</artifactId><scope>test</scope></dependency>

        <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.awaitility</groupId><artifactId>awaitility</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.pangrova</groupId><artifactId>pangrova-testing-kit</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-postgresql</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.lancedb</groupId><artifactId>lance-core</artifactId><version>0.39.0</version><scope>test</scope></dependency>
            <dependency><groupId>org.pangrova</groupId><artifactId>pangrova-persistence-jdbc-support</artifactId><scope>test</scope></dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>managed-source-fixtures</id>
                        <phase>test-compile</phase>
                        <goals><goal>test-jar</goal></goals>
                        <configuration>
                            <includes>
                                <include>org/pangrova/connector/lance/LanceManagedSourceTestExecution*.class</include>
                                <include>org/pangrova/connector/lance/LanceManagedSourceFixture*.class</include>
                                <include>org/pangrova/connector/lance/LanceCatalogTestDatabase*.class</include>
                                <include>org/pangrova/connector/lance/LanceFixtureSchema*.class</include>
                                <include>org/pangrova/connector/lance/LanceNativeSdkFixture*.class</include>
                                <include>org/pangrova/connector/lance/LanceSdkPreparationActor*.class</include>
                                <include>org/pangrova/connector/lance/LancePgSdkTestInputs*.class</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
