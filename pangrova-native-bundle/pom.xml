<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.pangrova</groupId>
        <artifactId>pangrova-bom</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>pangrova-native-bundle</artifactId>
    <packaging>pom</packaging>
    <name>Pangrova Native Bundle</name>
    <description>
        Per-platform classifier JAR containing the native JNI library (libpangrova_native).
        Follows the Netty tcnative-boringssl-static / sqlite-jdbc pattern:
        each platform produces a separate JAR with classifier (e.g. linux-x86_64, osx-aarch_64).
        Consumers depend on this artifact with ${os.detected.classifier} to auto-select
        the correct platform at build time.
    </description>

    <!--
      This module is a packaging-only module. It does NOT contain Java source code.
      The release workflow:
        1. Builds libpangrova_native.{so,dylib} on each platform via CMake
        2. Stages the library into the bridge-owned resource root
           pangrova-worker/pangrova-worker-native-bridge/src/main/resources/META-INF/native/{os}/{arch}/
        3. Runs: mvn package -pl pangrova-native-bundle -Dnative.resource.dir=...
        4. Installs/deploys the JAR with classifier matching the build platform

      Development builds skip this module (no native lib to bundle).
    -->

    <build>
        <plugins>
            <!--
              maven-jar-plugin produces the classifier JAR.
              The classifier is set by CI via -Dnative.platform.classifier=linux-x86_64
              For local dev, this module is typically skipped.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <classifier>${native.platform.classifier}</classifier>
                </configuration>
            </plugin>
        </plugins>

        <!--
          Native libraries are staged into the bridge module's resource root by CI
          before packaging. This keeps one staged copy shared by the loader resource
          and this classifier JAR, so a stale Native payload cannot pair with new Java.
          Resource path convention: META-INF/native/{os}/{arch}/libpangrova_native.{so,dylib}
          This matches NativeLibraryLoader's classpath extraction path.
        -->
        <resources>
            <resource>
                <directory>${native.resource.dir}</directory>
                <targetPath>META-INF/native/${native.resource.os}/${native.resource.arch}</targetPath>
                <includes>
                    <include>libpangrova_native.*</include>
                </includes>
                <filtering>false</filtering>
            </resource>
        </resources>
    </build>

    <profiles>
        <!--
          enforce-native-lib: activated when native.platform.classifier IS set.
          Ensures the native library directory exists before packaging.
        -->
        <profile>
            <id>enforce-native-lib</id>
            <activation>
                <property>
                    <name>native.platform.classifier</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>stage-native-classifier</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>resources</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>package-native-classifier</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>enforce-native-lib-present</id>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <phase>validate</phase>
                                <configuration>
                                    <rules>
                                        <requireFilesExist>
                                            <files>
                                                <file>${native.library.path}</file>
                                            </files>
                                            <message>
                                                The exact classifier native library must exist when packaging.
                                                Stage the CMake output and set -Dnative.library.path to that file.
                                            </message>
                                        </requireFilesExist>
                                    </rules>
                                    <fail>true</fail>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          skip-native-bundle: activated when native.platform.classifier is NOT set.
          This prevents build failures during normal development (mvn clean install)
          where no native library is available to bundle.
        -->
        <profile>
            <id>skip-native-bundle</id>
            <activation>
                <property>
                    <name>!native.platform.classifier</name>
                </property>
            </activation>
            <properties>
                <maven.install.skip>true</maven.install.skip>
                <maven.deploy.skip>true</maven.deploy.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <configuration>
                            <skipIfEmpty>true</skipIfEmpty>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
