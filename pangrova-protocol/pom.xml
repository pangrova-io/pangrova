<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.pangrova</groupId>
        <artifactId>pangrova-bom</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>pangrova-protocol</artifactId>
    <name>Pangrova Protocol</name>
    <description>Protobuf message definitions and REST API JSON schemas for Pangrova inter-process communication</description>

    <dependencies>
        <!-- Internal module dependencies (versions inherited from parent) -->
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pangrova</groupId>
            <artifactId>pangrova-spi</artifactId>
        </dependency>

        <!-- Synchronous columnar write batches shared by workers and connectors. -->
        <dependency>
            <groupId>org.apache.arrow</groupId>
            <artifactId>arrow-vector</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.arrow</groupId>
            <artifactId>arrow-memory-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.arrow</groupId>
            <artifactId>arrow-memory-unsafe</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Protobuf runtime -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>

        <!--
          The v2 boundary schema references the pinned official Substrait
          protobuf types directly. Keep this dependency aligned with the
          vendored import-only IDL; do not generate a second copy of the
          io.substrait.proto Java classes in this module.
        -->
        <dependency>
            <groupId>io.substrait</groupId>
            <artifactId>core</artifactId>
        </dependency>

        <!-- gRPC runtime (optional: modules needing gRPC declare their own dependency) -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.apache.tomcat</groupId>
            <artifactId>annotations-api</artifactId>
            <version>${tomcat-annotations-api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jackson for REST DTOs (optional: modules needing JSON declare their own dependency) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>

        <!-- Test dependencies (versions inherited from parent) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>generate-canonical-type-layout-naming</id>
                        <phase>generate-sources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>${pangrova.function-contract.python}</executable>
                            <sourceRoot>${project.build.directory}/generated-sources/function-contracts</sourceRoot>
                            <arguments>
                                <argument>-B</argument>
                                <argument>${project.basedir}/tools/function-contracts/generate_structural_contracts.py</argument>
                                <argument>--declaration</argument>
                                <argument>${project.basedir}/src/main/resources/function-contracts/sql-bindings.json</argument>
                                <argument>--java-root</argument>
                                <argument>${project.build.directory}/generated-sources/function-contracts</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-function-execution-selection</id>
                        <phase>generate-sources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>${pangrova.function-contract.python}</executable>
                            <sourceRoot>${project.build.directory}/generated-sources/function-contracts</sourceRoot>
                            <arguments>
                                <argument>-B</argument>
                                <argument>${project.basedir}/tools/function-contracts/generate_execution_selection.py</argument>
                                <argument>--declaration</argument>
                                <argument>${project.basedir}/src/main/resources/function-contracts/execution-selection.json</argument>
                                <argument>--java-root</argument>
                                <argument>${project.build.directory}/generated-sources/function-contracts</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <configuration>
                    <!-- Vendored Substrait IDL is canonical import-only input.
                         Java classes come from io.substrait:core; compiling it
                         here would create duplicate io.substrait.proto classes. -->
                    <importPaths>
                        <importPath>${project.basedir}/src/main/proto-imports</importPath>
                    </importPaths>
                    <binaryMavenPlugins>
                        <binaryMavenPlugin>
                            <groupId>io.grpc</groupId>
                            <artifactId>protoc-gen-grpc-java</artifactId>
                            <version>${grpc.version}</version>
                        </binaryMavenPlugin>
                    </binaryMavenPlugins>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
