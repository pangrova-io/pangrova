// Docusaurus uses its own config for start/build; this config drives the IDE
// and pnpm run typecheck. Keep the @docusaurus/tsconfig 3.10.1 compiler options
// here because the upstream baseUrl is no longer supported by TypeScript 7.
{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true,
    "strict": true
  },
  "exclude": [".docusaurus", "build"]
}
